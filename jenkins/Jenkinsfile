// ============================================================
// Water Quality Sampling Portal — Declarative CI/CD Pipeline
// Toolchain: Maven + JUnit + Selenium gate + Docker + Compose deploy
// Failed tests abort the run, so Deploy never executes on red builds.
// ============================================================

pipeline {
    agent any

    parameters {
        string(name: 'ENV_NAME', defaultValue: 'staging',
               description: 'Target environment label (staging | prod). Names the fallback container and labels the run; the compose deployment uses project wq-portal.')
        booleanParam(name: 'SKIP_SELENIUM', defaultValue: false,
                     description: 'Skip the Selenium quality gate (e.g. headless runner unavailable).')
        password(name: 'ADMIN_PASSWORD', defaultValue: '',
                 description: 'Bootstrap admin password for FRESH prod databases (empty = no users created; required on first deploy).')
    }

    environment {
        // Static default only — declarative `environment` cannot run steps.
        // The real version is resolved from git tags in Checkout below.
        APP_VERSION = "1.0.0"
        IMAGE = "water-quality-portal:1.0.0"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    String v = sh(
                        script: 'git describe --tags --abbrev=0 2>/dev/null || echo 1.0.0',
                        returnStdout: true).trim()
                    if (!v) {
                        v = '1.0.0'
                    }
                    v = v.replaceFirst(/^v/, '') // tags are vX.Y.Z, image tags are X.Y.Z
                    env.APP_VERSION = v
                    env.IMAGE = "water-quality-portal:${v}"
                    echo "Building version: ${env.APP_VERSION} (image ${env.IMAGE})"
                }
            }
        }

        stage('Build') {
            steps {
                // Prefer Temurin 21 if installed (Jenkins macOS/Linux agents),
                // otherwise fall back to whatever java is on PATH.
                sh '''
                    if [ -d "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home" ]; then
                        export JAVA_HOME="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
                    elif command -v /usr/libexec/java_home >/dev/null 2>&1; then
                        export JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null || echo "$JAVA_HOME")"
                    fi
                    echo "JAVA_HOME=$JAVA_HOME"
                    java -version
                    cd water-quality-portal && mvn -B clean package -DskipTests
                '''
            }
        }

        stage('Unit Test') {
            steps {
                // Selenium journeys are excluded here; they run in the gate below
                // so SKIP_SELENIUM can actually skip them on browserless agents.
                sh '''
                    cd water-quality-portal && mvn -B test -Dtest='!WaterQualitySeleniumTest'
                '''
            }
            post {
                always {
                    junit testResults: 'water-quality-portal/target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Selenium Quality Gate') {
            when {
                expression { return !params.SKIP_SELENIUM }
            }
            steps {
                // Headless-Chrome journeys (WaterQualitySeleniumTest, j1-j5).
                // -DfailIfNoTests=true: the gate must RUN tests, never pass vacuously.
                sh '''
                    cd water-quality-portal && \
                      mvn -B test -Dtest='WaterQualitySeleniumTest' -DfailIfNoTests=true
                '''
            }
            post {
                always {
                    junit testResults: 'water-quality-portal/target/surefire-reports/*.xml',
                          allowEmptyResults: true
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'water-quality-portal/target/*.war',
                                 fingerprint: true, onlyIfSuccessful: true
            }
        }

        stage('Docker Build') {
            steps {
                sh "docker build -f docker/Dockerfile -t ${env.IMAGE} ."
            }
        }

        stage('Docker Publish') {
            steps {
                script {
                    // Tag :latest alias alongside the versioned tag.
                    sh "docker tag ${env.IMAGE} water-quality-portal:latest"
                    // Push to a registry only when one is configured; default
                    // keeps the image in the local daemon (works offline).
                    // To enable Docker Hub, wrap with:
                    //   withRegistry('', 'docker-hub-credentials') {
                    //     sh "docker push ${env.IMAGE}"
                    //   }
                    echo "Image ready locally: ${env.IMAGE} (alias :latest)"
                }
            }
        }

        stage('Deploy') {
            steps {
                // NOTE: reached only if every prior stage (incl. tests) passed.
                // Declarative pipelines abort on first failure, so a red
                // Unit Test / Selenium gate stops deployment automatically.
                sh '''
                    ENV_NAME="${ENV_NAME:-staging}"
                    echo "Deploying version ${APP_VERSION} to environment: $ENV_NAME"
                    if docker compose version >/dev/null 2>&1; then
                        APP_VERSION="${APP_VERSION}" ENV_NAME="$ENV_NAME" \
                          ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
                          docker compose -f docker/docker-compose.yml up -d
                    else
                        docker rm -f "wq-portal-app-$ENV_NAME" 2>/dev/null || true
                        docker run -d --name "wq-portal-app-$ENV_NAME" -p 8080:8080 \
                          -e SPRING_PROFILES_ACTIVE=prod \
                          -e DB_URL=jdbc:postgresql://host.docker.internal:5432/waterquality \
                          -e DB_USER=wquser -e DB_PASS=wqpass \
                          -e ADMIN_PASSWORD="${ADMIN_PASSWORD}" \
                          "water-quality-portal:${APP_VERSION}"
                    fi
                    for i in $(seq 1 24); do
                      if curl -f http://localhost:8080/water-quality-portal/actuator/health; then
                        echo "Deploy healthy."
                        break
                      fi
                      if [ "$i" = "24" ]; then
                        echo "Deploy health check FAILED after 2 minutes."
                        exit 1
                      fi
                      sleep 5
                    done
                '''
            }
        }
    }

    post {
        always {
            junit testResults: 'water-quality-portal/target/surefire-reports/*.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'water-quality-portal/target/*.war', allowEmptyArchive: true
        }
        failure {
            echo "Pipeline FAILED — deployment was NOT performed (see failed stage above)."
        }
        success {
            echo "Pipeline OK — version ${env.APP_VERSION} deployed to ${params.ENV_NAME}."
        }
    }
}
